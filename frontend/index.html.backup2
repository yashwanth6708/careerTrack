<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CareerTrack | Smart Job Search Platform</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- ==========================================
         AUTHENTICATION SCREEN
    =========================================== -->

    <section id="auth-view" class="auth-wrapper">

        <div class="auth-card">

            <h1>CareerTrack</h1>

            <p class="auth-subtitle">
                Your personal job search companion
            </p>

            <!-- Login and Register Tabs -->

            <div class="auth-tabs">

                <button
                    type="button"
                    id="show-login"
                    class="auth-tab active"
                >
                    Login
                </button>

                <button
                    type="button"
                    id="show-register"
                    class="auth-tab"
                >
                    Register
                </button>

            </div>


            <!-- LOGIN FORM -->

            <form id="login-form">

                <div class="form-group">

                    <label for="login-email">
                        Email Address
                    </label>

                    <input
                        type="email"
                        id="login-email"
                        placeholder="Enter your email"
                        autocomplete="email"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="login-password">
                        Password
                    </label>

                    <input
                        type="password"
                        id="login-password"
                        placeholder="Enter your password"
                        autocomplete="current-password"
                        required
                    >

                </div>


                <button
                    type="submit"
                    class="btn-primary auth-submit"
                >
                    Login
                </button>

                <p
                    id="login-message"
                    role="status"
                    aria-live="polite"
                ></p>

            </form>


            <!-- REGISTRATION FORM -->

            <form id="register-form" hidden>

                <div class="form-group">

                    <label for="register-name">
                        Full Name
                    </label>

                    <input
                        type="text"
                        id="register-name"
                        placeholder="Enter your full name"
                        maxlength="100"
                        autocomplete="name"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="register-email">
                        Email Address
                    </label>

                    <input
                        type="email"
                        id="register-email"
                        placeholder="Enter your email"
                        autocomplete="email"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="register-password">
                        Create Password
                    </label>

                    <input
                        type="password"
                        id="register-password"
                        placeholder="Minimum 8 characters"
                        minlength="8"
                        autocomplete="new-password"
                        required
                    >

                </div>


                <button
                    type="submit"
                    class="btn-primary auth-submit"
                >
                    Create Account
                </button>

                <p
                    id="register-message"
                    role="status"
                    aria-live="polite"
                ></p>

            </form>

        </div>

    </section>


    <!-- ==========================================
         DASHBOARD HEADER
    =========================================== -->

    <header class="header">

        <div>

            <h1>CareerTrack</h1>

            <p>
                Your personal job search dashboard
            </p>

        </div>


        <div class="header-actions">

            <span id="user-greeting">
                Welcome!
            </span>

            <button
                id="logout-btn"
                class="btn-secondary"
                type="button"
            >
                Logout
            </button>

        </div>

    </header>


    <!-- ==========================================
         MAIN DASHBOARD
    =========================================== -->

    <main id="dashboard-view" class="container" hidden>


        <!-- Welcome Section -->

        <section class="welcome">

            <h2>Welcome to your career dashboard!</h2>

            <p>
                Track applications, monitor progress, and stay organized.
            </p>

        </section>


        <!-- ======================================
             DASHBOARD STATISTICS
        ======================================= -->

        <section class="stats">

            <div class="stat-card">

                <p>Total Applications</p>

                <h2 id="total-count">0</h2>

            </div>


            <div class="stat-card">

                <p>Applied</p>

                <h2 id="applied-count">0</h2>

            </div>


            <div class="stat-card">

                <p>Interviews</p>

                <h2 id="interview-count">0</h2>

            </div>


            <div class="stat-card">

                <p>Selected</p>

                <h2 id="selected-count">0</h2>

            </div>

        </section>


        <!-- ======================================
             ADVANCED ANALYTICS
        ======================================= -->

        <section class="advanced-stats">


            <div class="stat-card">

                <p>Interview Status Rate</p>

                <h2 id="interview-rate">0%</h2>

                <small>
                    Applications currently marked Interview
                </small>

            </div>


            <div class="stat-card">

                <p>Selection Rate</p>

                <h2 id="selection-rate">0%</h2>

                <small>
                    Applications currently marked Selected
                </small>

            </div>


            <div class="stat-card">

                <p>Rejection Rate</p>

                <h2 id="rejection-rate">0%</h2>

                <small>
                    Applications currently marked Rejected
                </small>

            </div>


            <div class="stat-card">

                <p>Applications This Month</p>

                <h2 id="monthly-applications">0</h2>

                <small>
                    Based on application date
                </small>

            </div>


        </section>


        <!-- ======================================
             APPLICATION TIMELINE
        ======================================= -->

        <section class="panel timeline-panel">

            <h2>Application Timeline</h2>

            <p>
                Track your job applications month by month.
            </p>

            <div class="chart-container">

                <canvas id="application-timeline-chart"></canvas>

            </div>

        </section>


        <!-- ======================================
             SMART CAREER INSIGHTS
        ======================================= -->

        <section class="panel insights-panel">

            <h2>Smart Career Insights</h2>

            <p>
                Insights generated automatically from your applications.
            </p>

            <div
                id="smart-insights"
                class="insights-grid"
            >

                <p>Analyzing your applications...</p>

            </div>

        </section>


        <!-- ======================================
             APPLICATION ANALYTICS CHARTS
        ======================================= -->

        <section class="analytics">


            <!-- Doughnut Chart -->

            <div class="panel chart-panel">

                <h2>Application Status Distribution</h2>

                <p>
                    See how your applications are progressing.
                </p>

                <div class="chart-container">

                    <canvas id="status-doughnut-chart"></canvas>

                </div>

            </div>


            <!-- Bar Chart -->

            <div class="panel chart-panel">

                <h2>Applications by Status</h2>

                <p>
                    Compare your application counts.
                </p>

                <div class="chart-container">

                    <canvas id="status-bar-chart"></canvas>

                </div>

            </div>


        </section>


        <!-- ======================================
             ADD JOB APPLICATION
        ======================================= -->

        <section class="panel">

            <h2>Add Job Application</h2>

            <p>
                Record a new job application and track its progress.
            </p>


            <form id="application-form">

                <div class="form-grid">


                    <!-- Company Name -->

                    <div class="form-group">

                        <label for="company">
                            Company Name
                        </label>

                        <input
                            type="text"
                            id="company"
                            placeholder="e.g. TCS"
                            maxlength="100"
                            required
                        >

                    </div>


                    <!-- Job Role -->

                    <div class="form-group">

                        <label for="role">
                            Job Role
                        </label>

                        <input
                            type="text"
                            id="role"
                            placeholder="e.g. Python Developer"
                            maxlength="150"
                            required
                        >

                    </div>


                    <!-- Application Status -->

                    <div class="form-group">

                        <label for="status">
                            Application Status
                        </label>

                        <select id="status" required>

                            <option value="Applied">
                                Applied
                            </option>

                            <option value="Assessment">
                                Assessment
                            </option>

                            <option value="Interview">
                                Interview
                            </option>

                            <option value="Selected">
                                Selected
                            </option>

                            <option value="Rejected">
                                Rejected
                            </option>

                        </select>

                    </div>


                    <!-- Application Date -->

                    <div class="form-group">

                        <label for="application-date">
                            Application Date
                        </label>

                        <input
                            type="date"
                            id="application-date"
                            required
                        >

                    </div>


                    <!-- Notes -->

                    <div class="form-group notes-group">

                        <label for="notes">
                            Notes
                        </label>

                        <textarea
                            id="notes"
                            placeholder="Recruiter details, interview date, next steps..."
                            rows="3"
                        ></textarea>

                    </div>


                </div>


                <button
                    type="submit"
                    class="btn-primary"
                >
                    Add Application
                </button>


                <p
                    id="form-message"
                    role="status"
                    aria-live="polite"
                ></p>

            </form>

        </section>


        <!-- ======================================
             MY APPLICATIONS TABLE
        ======================================= -->

        <section class="panel">


            <!-- Table Heading -->

            <div class="section-heading">

                <div>

                    <h2>My Applications</h2>

                    <p>
                        Manage and track your job applications.
                    </p>

                </div>


                <button
                    id="refresh-btn"
                    class="btn-secondary"
                    type="button"
                >
                    Refresh
                </button>

            </div>


            <!-- Search and Status Filters -->

            <div class="filters">


                <input
                    type="search"
                    id="search-input"
                    placeholder="Search company or job role..."
                    aria-label="Search applications"
                >


                <select
                    id="filter-status"
                    aria-label="Filter applications by status"
                >

                    <option value="All">
                        All Statuses
                    </option>

                    <option value="Applied">
                        Applied
                    </option>

                    <option value="Assessment">
                        Assessment
                    </option>

                    <option value="Interview">
                        Interview
                    </option>

                    <option value="Selected">
                        Selected
                    </option>

                    <option value="Rejected">
                        Rejected
                    </option>

                </select>


            </div>


            <!-- Table Message -->

            <div
                id="table-message"
                role="status"
                aria-live="polite"
            ></div>


            <!-- Applications Table -->

            <div class="table-container">

                <table>

                    <thead>

                        <tr>

                            <th>ID</th>

                            <th>Company</th>

                            <th>Job Role</th>

                            <th>Status</th>

                            <th>Application Date</th>

                            <th>Notes</th>

                            <th>Update Status</th>

                            <th>Actions</th>

                        </tr>

                    </thead>


                    <tbody id="applications-table">

                        <tr>

                            <td colspan="8">
                                Loading applications...
                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>


        </section>


    </main>


    <!-- ==========================================
         FOOTER
    =========================================== -->

    <footer id="dashboard-footer" class="footer" hidden>

        <p>
            CareerTrack &copy; 2026 |
            Built to organize your career journey
        </p>

    </footer>


    <!-- ==========================================
         JAVASCRIPT
    =========================================== -->

    <!-- Chart.js library -->

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- CareerTrack application logic -->

    <script src="script.js"></script>


</body>

</html>
