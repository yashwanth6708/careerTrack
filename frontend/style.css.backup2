/* =========================================
   CAREERTRACK — PREMIUM DASHBOARD
========================================= */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
    --primary: #4f46e5;
    --primary-dark: #4338ca;
    --primary-light: #eef2ff;
    --background: #f5f7fb;
    --surface: #ffffff;
    --text: #172033;
    --muted: #748096;
    --border: #e5e9f2;
    --green: #16a34a;
    --orange: #ea580c;
    --red: #dc2626;
    --shadow: 0 8px 28px rgba(25, 35, 65, 0.05);
}

* {
    box-sizing: border-box;
}

[hidden] {
    display: none !important;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background: var(--background);
    color: var(--text);
    font-family: 'Inter', Arial, sans-serif;
    font-size: 14px;
    line-height: 1.6;
}

button,
input,
select,
textarea {
    font: inherit;
}

button {
    cursor: pointer;
    transition: 0.2s ease;
}

h1,
h2,
h3,
p {
    margin-top: 0;
}

h1,
h2,
h3 {
    letter-spacing: -0.4px;
}

p {
    color: var(--muted);
}

/* =========================================
   AUTHENTICATION
========================================= */

.auth-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background:
        radial-gradient(circle at top left, #e0e7ff, transparent 40%),
        radial-gradient(circle at bottom right, #dbeafe, transparent 40%),
        #f5f7fb;
}

.auth-card {
    width: 100%;
    max-width: 430px;
    padding: 38px;
    background: var(--surface);
    border: 1px solid rgba(229, 233, 242, 0.8);
    border-radius: 20px;
    box-shadow: 0 24px 70px rgba(35, 45, 90, 0.12);
}

.auth-card > h1 {
    margin-bottom: 5px;
    color: var(--primary);
    font-size: 32px;
    font-weight: 800;
    text-align: center;
}

.auth-subtitle {
    margin-bottom: 28px;
    text-align: center;
}

.auth-tabs {
    display: flex;
    gap: 8px;
    padding: 5px;
    margin-bottom: 25px;
    background: #f1f3f9;
    border-radius: 11px;
}

.auth-tab {
    flex: 1;
    padding: 11px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    font-weight: 600;
}

.auth-tab.active {
    background: white;
    color: var(--primary);
    box-shadow: 0 2px 8px rgba(25, 35, 65, 0.08);
}

.auth-card .form-group {
    margin-bottom: 18px;
}

.auth-card input {
    width: 100%;
    box-sizing: border-box;
    padding: 12px 14px;
    margin-top: 7px;
    border: 1px solid var(--border);
    border-radius: 9px;
    font-size: 14px;
}

.auth-submit {
    width: 100%;
    margin-top: 8px;
}

/* =========================================
   DASHBOARD HEADER
========================================= */

.header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 18px 5%;
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(12px);
}

.header h1 {
    margin-bottom: 0;
    color: var(--primary);
    font-size: 25px;
    font-weight: 800;
}

.header p {
    margin: 2px 0 0;
    font-size: 12px;
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
}

#user-greeting {
    color: var(--text);
    font-weight: 600;
}

/* =========================================
   MAIN LAYOUT
========================================= */

.container {
    width: min(1400px, 92%);
    margin: 0 auto;
    padding: 32px 0 55px;
}

.welcome {
    position: relative;
    overflow: hidden;
    padding: 34px;
    margin-bottom: 26px;
    border-radius: 18px;
    background: linear-gradient(120deg, #4338ca, #6366f1 65%, #818cf8);
    box-shadow: 0 12px 30px rgba(79, 70, 229, 0.18);
}

.welcome::after {
    position: absolute;
    top: -75px;
    right: -30px;
    width: 250px;
    height: 250px;
    border: 35px solid rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    content: "";
}

.welcome h2 {
    position: relative;
    z-index: 1;
    margin-bottom: 8px;
    color: white;
    font-size: clamp(22px, 3vw, 30px);
}

.welcome p {
    position: relative;
    z-index: 1;
    max-width: 650px;
    margin-bottom: 0;
    color: #e0e7ff;
    font-size: 14px;
}

/* =========================================
   STATISTICS CARDS
========================================= */

.stats,
.advanced-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 24px;
}

.stat-card {
    min-width: 0;
    padding: 23px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 15px;
    box-shadow: var(--shadow);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.stat-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgba(25, 35, 65, 0.08);
}

.stat-card p {
    margin-bottom: 12px;
    font-size: 13px;
    font-weight: 600;
}

.stat-card h2 {
    margin-bottom: 0;
    color: var(--text);
    font-size: 32px;
    font-weight: 800;
    line-height: 1.2;
}

.stat-card small {
    display: block;
    margin-top: 10px;
    color: var(--muted);
    font-size: 11px;
}

/* Accent the main statistic cards */

.stats .stat-card:nth-child(1) {
    border-top: 3px solid #6366f1;
}

.stats .stat-card:nth-child(2) {
    border-top: 3px solid #0ea5e9;
}

.stats .stat-card:nth-child(3) {
    border-top: 3px solid #f59e0b;
}

.stats .stat-card:nth-child(4) {
    border-top: 3px solid #22c55e;
}

/* =========================================
   PANELS AND CHARTS
========================================= */

.panel {
    min-width: 0;
    padding: 25px;
    margin-bottom: 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 15px;
    box-shadow: var(--shadow);
}

.panel h2 {
    margin-bottom: 5px;
    font-size: 18px;
    font-weight: 700;
}

.panel > p,
.panel > div > p {
    margin-bottom: 20px;
    font-size: 13px;
}

.analytics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
    margin-bottom: 24px;
}

.analytics .panel {
    margin-bottom: 0;
}

.chart-container {
    position: relative;
    width: 100%;
    height: 300px;
}

.timeline-panel .chart-container {
    height: 280px;
}

.insights-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
}

.insights-grid > * {
    padding: 16px;
    margin: 0;
    background: #f8f9ff;
    border: 1px solid #e8eaff;
    border-radius: 11px;
}

/* =========================================
   FORMS
========================================= */

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 22px;
}

.form-group {
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.form-group label {
    margin-bottom: 6px;
    color: #374151;
    font-size: 13px;
    font-weight: 600;
}

.form-group input,
.form-group select,
.form-group textarea,
.filters input,
.filters select {
    width: 100%;
    min-width: 0;
    padding: 12px 13px;
    color: var(--text);
    background: white;
    border: 1px solid #dce2ec;
    border-radius: 9px;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus,
.filters input:focus,
.filters select:focus,
.auth-card input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.10);
}

.form-group textarea {
    resize: vertical;
}

.notes-group {
    grid-column: 1 / -1;
}

/* =========================================
   BUTTONS
========================================= */

.btn-primary,
.btn-secondary,
button.btn-primary,
button.btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 42px;
    padding: 10px 18px;
    border-radius: 9px;
    font-weight: 600;
}

.btn-primary {
    color: white;
    background: var(--primary);
    border: 1px solid var(--primary);
}

.btn-primary:hover {
    background: var(--primary-dark);
    border-color: var(--primary-dark);
    transform: translateY(-1px);
}

.btn-secondary {
    color: #374151;
    background: white;
    border: 1px solid var(--border);
}

.btn-secondary:hover {
    color: var(--primary);
    background: var(--primary-light);
    border-color: #c7d2fe;
}

#logout-btn {
    min-height: 38px;
    padding: 8px 14px;
}

#form-message,
#login-message,
#register-message,
#table-message {
    overflow-wrap: anywhere;
}

/* =========================================
   APPLICATIONS TABLE
========================================= */

.section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
}

.section-heading h2 {
    margin-bottom: 5px;
}

.section-heading p {
    margin-bottom: 0;
}

.filters {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 12px;
    margin-bottom: 18px;
}

.table-container {
    width: 100%;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 10px;
}

table {
    width: 100%;
    min-width: 900px;
    border-collapse: collapse;
    text-align: left;
}

thead {
    background: #f7f8fc;
}

th {
    padding: 14px 15px;
    color: #657087;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    white-space: nowrap;
}

td {
    padding: 14px 15px;
    color: #3d4658;
    border-top: 1px solid #edf0f5;
    font-size: 13px;
    vertical-align: middle;
}

tbody tr {
    transition: background 0.15s;
}

tbody tr:hover {
    background: #fafbff;
}

td button,
td select {
    margin: 3px;
}

/* =========================================
   FOOTER
========================================= */

.footer {
    padding: 24px;
    background: white;
    border-top: 1px solid var(--border);
    text-align: center;
}

.footer p {
    margin-bottom: 0;
    font-size: 12px;
}

/* =========================================
   RESPONSIVE DESIGN
========================================= */

@media (max-width: 1000px) {
    .stats,
    .advanced-stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .container {
        width: 94%;
    }
}

@media (max-width: 720px) {
    .header {
        position: static;
        align-items: flex-start;
        padding: 16px 5%;
    }

    .header h1 {
        font-size: 22px;
    }

    .header-actions {
        justify-content: flex-end;
        gap: 9px;
    }

    #user-greeting {
        font-size: 12px;
    }

    .welcome {
        padding: 25px;
    }

    .analytics {
        grid-template-columns: 1fr;
    }

    .chart-container {
        height: 260px;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .notes-group {
        grid-column: auto;
    }

    .filters {
        grid-template-columns: 1fr;
    }

    .panel {
        padding: 19px;
    }

    .insights-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 480px) {
    .auth-card {
        padding: 25px 21px;
    }

    .header {
        flex-direction: column;
        gap: 12px;
    }

    .header-actions {
        width: 100%;
        justify-content: space-between;
    }

    .container {
        width: 92%;
        padding-top: 20px;
    }

    .stats,
    .advanced-stats {
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .stat-card {
        padding: 20px;
    }

    .stat-card h2 {
        font-size: 28px;
    }

    .section-heading {
        align-items: flex-start;
    }

    .panel {
        padding: 16px;
    }

    .welcome h2 {
        font-size: 23px;
    }
}
/* ==========================================
   CAREERTRACK — PROFESSIONAL AUTH PAGES
========================================== */

.auth-wrapper {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 0;
    background: #ffffff;
}

.auth-card {
    grid-column: 2;
    grid-row: 1;
    width: 100%;
    max-width: 480px;
    align-self: center;
    justify-self: center;
    padding: 48px;
    background: #ffffff;
    border: none;
    border-radius: 0;
    box-shadow: none;
}

.auth-card > h1 {
    text-align: left;
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -1px;
    color: #4338ca;
}

.auth-subtitle {
    margin-bottom: 32px;
    text-align: left;
    color: #64748b;
    font-size: 14px;
}

.auth-tabs {
    padding: 4px;
    gap: 5px;
    background: #f1f5f9;
    border-radius: 10px;
}

.auth-tab {
    padding: 12px;
    border-radius: 8px;
}

.auth-tab.active {
    background: #ffffff;
    color: #4338ca;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.08);
}

.auth-card .form-group {
    margin-bottom: 22px;
}

.auth-card label {
    display: block;
    margin-bottom: 7px;
    color: #334155;
    font-size: 13px;
    font-weight: 600;
}

.auth-card input {
    width: 100%;
    padding: 13px 14px;
    margin-top: 0;
    background: #ffffff;
    border: 1px solid #dbe2ea;
    border-radius: 9px;
    font-size: 14px;
    transition: border-color 0.2s, box-shadow 0.2s;
}

.auth-card input::placeholder {
    color: #9ca3af;
}

.auth-card input:focus {
    outline: none;
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
}

.auth-submit {
    width: 100%;
    min-height: 46px;
    margin-top: 8px;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 700;
}

#login-message,
#register-message {
    margin-top: 16px;
    font-size: 13px;
    overflow-wrap: anywhere;
}

/* Add the branded panel without changing HTML */

.auth-wrapper::before {
    content:
        "CAREERTRACK\A\A"
        "Your next opportunity\A"
        "starts here.\A\A"
        "Organize your job search.\A"
        "Track applications and interviews.\A"
        "Move forward with confidence.";

    grid-column: 1;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100vh;
    padding: 10%;
    white-space: pre-line;
    color: #ffffff;
    font-size: 19px;
    line-height: 2;
    font-weight: 500;
    background: linear-gradient(145deg, #312e81, #4338ca 60%, #6366f1);
}

/* Mobile layout */

@media (max-width: 760px) {
    .auth-wrapper {
        grid-template-columns: 1fr;
        align-content: center;
        min-height: 100vh;
        padding: 20px;
        background: #f5f7fb;
    }

    .auth-wrapper::before {
        display: none;
    }

    .auth-card {
        grid-column: 1;
        grid-row: 1;
        max-width: 440px;
        padding: 30px 24px;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        box-shadow: 0 12px 40px rgba(15, 23, 42, 0.07);
    }

    .auth-card > h1 {
        font-size: 28px;
    }
}

@media (max-width: 380px) {
    .auth-wrapper {
        padding: 12px;
    }

    .auth-card {
        padding: 24px 18px;
    }
}
/* =========================================
   CAREERTRACK — PREMIUM UI ENHANCEMENTS
   ========================================= */

:root {
    --ct-primary: #4f46e5;
    --ct-primary-dark: #3730a3;
    --ct-primary-light: #eef2ff;
    --ct-text: #172033;
    --ct-muted: #64748b;
    --ct-border: #e2e8f0;
    --ct-surface: #ffffff;
    --ct-background: #f5f7fc;
    --ct-radius: 14px;
    --ct-shadow: 0 8px 30px rgba(15, 23, 42, 0.06);
}

/* General improvements */

body {
    color: var(--ct-text);
    background: var(--ct-background);
    -webkit-font-smoothing: antialiased;
}

button,
input,
select,
textarea {
    font-family: inherit;
}

button {
    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        background-color 0.2s ease;
}

button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
    outline: 3px solid rgba(99, 102, 241, 0.25);
    outline-offset: 2px;
}

/* =========================================
   AUTHENTICATION PAGES
   ========================================= */

.auth-wrapper {
    background: #ffffff;
}

.auth-card {
    animation: ctFadeIn 0.45s ease both;
}

.auth-card > h1 {
    letter-spacing: -1.2px;
}

.auth-subtitle {
    line-height: 1.7;
}

.auth-tabs {
    border: 1px solid #e9edf5;
}

.auth-tab {
    cursor: pointer;
    transition: all 0.2s ease;
}

.auth-tab:hover {
    color: var(--ct-primary);
}

.auth-card input {
    box-sizing: border-box;
}

.auth-card input:hover {
    border-color: #c7d2fe;
}

.auth-submit {
    color: #ffffff;
    background: linear-gradient(
        135deg,
        #4f46e5,
        #6366f1
    );
    border: none;
    box-shadow: 0 5px 14px rgba(79, 70, 229, 0.18);
    cursor: pointer;
}

.auth-submit:hover {
    background: linear-gradient(
        135deg,
        #4338ca,
        #4f46e5
    );
    box-shadow: 0 8px 20px rgba(79, 70, 229, 0.25);
    transform: translateY(-1px);
}

.auth-submit:active {
    transform: translateY(0);
}

/* =========================================
   DASHBOARD HEADER
   ========================================= */

.header {
    position: relative;
    background: #ffffff;
    border-bottom: 1px solid var(--ct-border);
    box-shadow: 0 2px 12px rgba(15, 23, 42, 0.025);
}

.header h1 {
    color: var(--ct-primary-dark);
    letter-spacing: -0.8px;
}

#user-greeting {
    color: var(--ct-muted);
    font-weight: 600;
}

#logout-btn {
    border-radius: 9px;
    cursor: pointer;
}

#logout-btn:hover {
    transform: translateY(-1px);
}

/* =========================================
   DASHBOARD CONTENT
   ========================================= */

.container {
    width: min(1200px, 92%);
    margin-right: auto;
    margin-left: auto;
}

.welcome {
    animation: ctFadeIn 0.5s ease both;
}

.welcome h2 {
    color: var(--ct-text);
    letter-spacing: -1px;
}

.welcome p {
    color: var(--ct-muted);
    line-height: 1.7;
}

/* =========================================
   STATISTICS CARDS
   ========================================= */

.stat-card,
.stats-card,
.metric-card {
    border: 1px solid var(--ct-border);
    border-radius: var(--ct-radius);
    background: var(--ct-surface);
    box-shadow: var(--ct-shadow);
    transition:
        transform 0.22s ease,
        box-shadow 0.22s ease,
        border-color 0.22s ease;
}

.stat-card:hover,
.stats-card:hover,
.metric-card:hover {
    transform: translateY(-4px);
    border-color: #c7d2fe;
    box-shadow: 0 14px 32px rgba(79, 70, 229, 0.09);
}

#total-count,
#applied-count,
#interview-count,
#selected-count {
    color: var(--ct-primary-dark);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
}

#interview-rate,
#selection-rate,
#rejection-rate,
#monthly-applications {
    font-variant-numeric: tabular-nums;
}

/* =========================================
   FORMS AND INPUTS
   ========================================= */

#application-form input,
#application-form select,
#application-form textarea,
#search-input,
#filter-status {
    box-sizing: border-box;
    border: 1px solid var(--ct-border);
    border-radius: 9px;
    background: #ffffff;
    color: var(--ct-text);
    transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;
}

#application-form input:focus,
#application-form select:focus,
#application-form textarea:focus,
#search-input:focus,
#filter-status:focus {
    outline: none;
    border-color: var(--ct-primary);
    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
}

#application-form label {
    color: #334155;
    font-weight: 600;
}

/* =========================================
   APPLICATION TABLE
   ========================================= */

#applications-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    background: #ffffff;
    border-radius: 12px;
    overflow: hidden;
}

#applications-table thead th {
    padding: 15px 16px;
    background: #f8fafc;
    color: #475569;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-align: left;
    text-transform: uppercase;
    border-bottom: 1px solid var(--ct-border);
}

#applications-table tbody td {
    padding: 15px 16px;
    color: #334155;
    border-bottom: 1px solid #edf0f5;
    vertical-align: middle;
}

#applications-table tbody tr {
    transition: background-color 0.18s ease;
}

#applications-table tbody tr:hover {
    background: #f8faff;
}

#applications-table tbody tr:last-child td {
    border-bottom: none;
}

#applications-table button {
    border-radius: 7px;
    cursor: pointer;
}

/* =========================================
   SEARCH, FILTER AND REFRESH
   ========================================= */

#search-input,
#filter-status {
    min-height: 42px;
    padding: 10px 13px;
}

#refresh-btn {
    min-height: 42px;
    padding: 10px 16px;
    border: none;
    border-radius: 9px;
    color: #ffffff;
    background: var(--ct-primary);
    font-weight: 600;
    cursor: pointer;
}

#refresh-btn:hover {
    background: var(--ct-primary-dark);
    transform: translateY(-1px);
}

/* =========================================
   MESSAGES
   ========================================= */

#form-message,
#table-message,
#login-message,
#register-message {
    line-height: 1.6;
    overflow-wrap: anywhere;
}

#form-message:empty,
#table-message:empty,
#login-message:empty,
#register-message:empty {
    display: none;
}

/* =========================================
   CHART CONTAINERS
   ========================================= */

#application-timeline-chart,
#status-doughnut-chart,
#status-bar-chart {
    max-width: 100%;
}

/* =========================================
   FOOTER
   ========================================= */

#dashboard-footer {
    color: var(--ct-muted);
    font-size: 13px;
    text-align: center;
    padding: 24px 0;
}

/* =========================================
   ANIMATIONS
   ========================================= */

@keyframes ctFadeIn {
    from {
        opacity: 0;
        transform: translateY(8px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* =========================================
   RESPONSIVE TABLE
   ========================================= */

@media (max-width: 900px) {
    #applications-table {
        font-size: 13px;
    }

    #applications-table thead th,
    #applications-table tbody td {
        padding: 11px 10px;
    }
}

@media (max-width: 760px) {
    .container {
        width: 94%;
    }

    .welcome h2 {
        font-size: 25px;
    }

    #applications-table {
        min-width: 700px;
    }

    /* Allow the table to scroll horizontally */
    #applications-table {
        display: table;
    }

    .auth-card {
        animation: ctFadeIn 0.35s ease both;
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
    }
}
/* =====================================
   CAREERTRACK AUTH PAGE — IMAGE PANEL
   ===================================== */

.auth-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100vh;
    padding: 0;
    background: #ffffff;
    overflow: hidden;
}

/* Left-side career illustration */

.auth-wrapper::before {
    content: "";
    grid-column: 1;
    grid-row: 1;
    min-height: 100vh;

    background-color: #312e81;
    background-image:
        linear-gradient(
            135deg,
            rgba(30, 27, 75, 0.25),
            rgba(79, 70, 229, 0.15)
        ),
        url("https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=1400&q=85");

    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}

/* Login and registration card */

.auth-card {
    grid-column: 2;
    grid-row: 1;
    justify-self: center;
    align-self: center;

    width: 100%;
    max-width: 480px;
    box-sizing: border-box;
    padding: 44px;

    background: #ffffff;
    border: none;
    border-radius: 0;
    box-shadow: none;
}

/* Heading */

.auth-card > h1 {
    color: #4338ca;
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -1px;
    text-align: left;
}

/* Subtitle */

.auth-subtitle {
    margin-bottom: 30px;
    color: #64748b;
    font-size: 14px;
    line-height: 1.7;
    text-align: left;
}

/* Form labels */

.auth-card label {
    display: block;
    margin-bottom: 8px;
    color: #334155;
    font-size: 13px;
    font-weight: 600;
}

/* Form fields */

.auth-card input {
    width: 100%;
    box-sizing: border-box;
    padding: 13px 14px;
    margin-top: 0;
    border: 1px solid #dbe2ea;
    border-radius: 9px;
    background: #ffffff;
    font-size: 14px;
    transition: 0.2s ease;
}

.auth-card input:focus {
    outline: none;
    border-color: #6366f1;
    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.12);
}

/* Login and register tabs */

.auth-tabs {
    display: flex;
    gap: 5px;
    padding: 4px;
    border-radius: 10px;
    background: #f1f5f9;
}

.auth-tab {
    flex: 1;
    padding: 12px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: 0.2s ease;
}

.auth-tab.active {
    color: #4338ca;
    background: #ffffff;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.08);
}

/* Submit button */

.auth-submit {
    width: 100%;
    min-height: 47px;
    margin-top: 10px;
    border: none;
    border-radius: 9px;
    color: #ffffff;
    background: linear-gradient(135deg, #4338ca, #6366f1);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: 0.2s ease;
}

.auth-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(79, 70, 229, 0.22);
}

/* Mobile layout */

@media (max-width: 760px) {
    .auth-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 20px;
        box-sizing: border-box;
        background: #f5f7fc;
    }

    .auth-wrapper::before {
        display: none;
    }

    .auth-card {
        width: 100%;
        max-width: 440px;
        padding: 30px 24px;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        box-shadow: 0 12px 40px rgba(15, 23, 42, 0.07);
    }

    .auth-card > h1 {
        font-size: 28px;
    }
}

@media (max-width: 380px) {
    .auth-wrapper {
        padding: 12px;
    }

    .auth-card {
        padding: 24px 18px;
    }
}
